# Dashboard reads apps/dashboard/.env.local
# Leave the Supabase lines empty to use the local demo sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Used once Drizzle talks to a database. Not required for Phase 0.
DATABASE_URL=
